# Copy to .env (git-ignored) and set a password of at least 8 characters.
NEO4J_USER=neo4j
NEO4J_PASSWORD=change-me-please
NEO4J_URI=bolt://localhost:7687
NEO4J_DATABASE=neo4j
# Neo4j Enterprise Edition needs you to accept the licence: set to yes (or eval). Not set by default on purpose.
NEO4J_ACCEPT_LICENSE_AGREEMENT=
# A second, DEVELOPMENT Neo4j server on the same machine (docker-compose.yml): set these four in .env, and point NEO4J_URI at
# bolt://localhost:7688. Defaults, with nothing set, are 7474, 7687, minecorp-neo4j and minecorp.
# NEO4J_HTTP_PORT=7475
# NEO4J_BOLT_PORT=7688
# NEO4J_CONTAINER_NAME=minecorp-neo4j-dev
# COMPOSE_PROJECT_NAME=minecorp-dev

# Agent service
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.4-mini
# AGENT_MAX_TURNS=6
# AGENT_LLM_TIMEOUT=40
AGENT_SHARED_SECRET=change-me-to-a-long-random-string
AGENT_HOST=127.0.0.1
AGENT_PORT=8080
