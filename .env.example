# Copy to .env (git-ignored) and set a password of at least 8 characters.
NEO4J_USER=neo4j
NEO4J_PASSWORD=change-me-please
NEO4J_URI=bolt://localhost:7687
NEO4J_DATABASE=neo4j

# Agent service
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.4-mini
# AGENT_MAX_TURNS=6
# AGENT_LLM_TIMEOUT=40
AGENT_SHARED_SECRET=change-me-to-a-long-random-string
AGENT_HOST=127.0.0.1
AGENT_PORT=8080
