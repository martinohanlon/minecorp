# Copy to .env (git-ignored) and set a password of at least 8 characters.
NEO4J_USER=neo4j
NEO4J_PASSWORD=change-me-please
NEO4J_URI=bolt://localhost:7687
NEO4J_DATABASE=neo4j
# Neo4j Enterprise Edition needs you to accept the licence: set to yes (or eval). Not set by default on purpose.
NEO4J_ACCEPT_LICENSE_AGREEMENT=
# A second, DEVELOPMENT Neo4j server on the same machine (docker-compose.yml): set these four in .env, and point NEO4J_URI at
# bolt://localhost:7688. Defaults, with nothing set, are 7474, 7687, minecorp-neo4j and minecorp.
# NEO4J_HTTP_PORT=7475
# NEO4J_BOLT_PORT=7688
# NEO4J_CONTAINER_NAME=minecorp-neo4j-dev
# COMPOSE_PROJECT_NAME=minecorp-dev

# Agent service
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.4-mini
# AGENT_MAX_TURNS=6
# AGENT_LLM_TIMEOUT=40
AGENT_SHARED_SECRET=change-me-to-a-long-random-string
AGENT_HOST=127.0.0.1
AGENT_PORT=8080

# Agent memory (neo4j-agent-memory): keeps each player's questions and answers, and a trace of the tools used, in Neo4j, so the
# explain book survives a restart. Off by default: with "local" the history is kept in the agent process only. See docs/agent-memory.md.
# AGENT_MEMORY=local
# AGENT_MEMORY=neo4j
# By default memory lives in the SAME database as the game graph (NEO4J_DATABASE), so long-term memory can link to items, mobs and so on.
# The cost: build-graph wipes the whole database, memory included. A separate database (Neo4j Enterprise; created for you if missing)
# survives a rebuild but cannot be linked to the game graph:
# AGENT_MEMORY_DATABASE=minecorpmemory
# Record the tools called for every run (a reasoning trace):
# AGENT_MEMORY_TRACES=true
# Embed messages and traces with OpenAI so memory can be searched by meaning (costs a little):
# AGENT_MEMORY_EMBED=false
# Long-term memory: an LLM extracts entities and preferences from what players say (costs tokens on every answer):
# AGENT_MEMORY_EXTRACT=false

# Conversation: how much of what a player said earlier goes to the model with their new question, so "and how many of those?" works.
# It does not need agent memory (the in-process history is used; memory refills it after a restart).
# AGENT_CONVERSATION_TURNS=3
# A player quiet for longer than this starts a new conversation:
# AGENT_CONVERSATION_IDLE_MINUTES=15
